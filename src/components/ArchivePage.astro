---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import repositories from '../data/repositories.json';
import { designPath, withBase, type Design } from '../lib/paths';
import { profile } from '../data/profile';
interface Props {
  variant?: Design;
}
const { variant = 'editorial' } = Astro.props;
const pageLink = (path = '') => designPath(variant, path);
const groups = [...new Set(repositories.map((repo) => repo.group))];
const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const repositoryKey = (url: string) => url.replace(/\/$/, '').toLowerCase();
// Share project images and destinations with the main portfolio so they stay current.
const entries = repositories.map((repo) => ({
  ...repo,
  projects: projects.filter(
    (project) =>
      project.data.repository &&
      repositoryKey(project.data.repository) === repositoryKey(repo.repository),
  ),
}));
---

<Layout
  variant={variant}
  pagePath="archive/"
  title={`Project archive — ${profile.name}`}
  description="Explore my applications, browser experiments, design studies, and development coursework."
>
  <section class="archive-section" aria-labelledby="archive-title">
    <a class="text-link back-link" href={pageLink('#work')}>
      ← Selected work
    </a>
    <header class="archive-header reveal">
      <p class="eyebrow">THE WORK, THE PRACTICE, THE PROCESS</p>
      <div class="archive-heading">
        <h1 id="archive-title">
          Project archive<span>.</span>
        </h1>
        <div class="archive-emblem" aria-hidden="true">
          <span>↗</span>
          <span>↗</span>
          <span>↗</span>
        </div>
      </div>
      <p>
        A broader look at my work: applications, small experiments, and the
        coursework behind them. Earlier exercises are included as part of the
        learning process.
      </p>
      <p class="archive-guide">
        Browse the screenshots, open a project story, or jump straight into a
        live demo. Shared repositories include individual projects below.
      </p>
    </header>
    <div class="archive-controls" hidden>
      <div class="archive-search">
        <label for="repo-search">Search projects</label>
        <input
          id="repo-search"
          type="search"
          placeholder="Search by name, technology, or topic…"
          autocomplete="off"
        />
      </div>
      <div>
        <label for="repo-group">Collection</label>
        <select id="repo-group">
          <option value="all">All collections</option>
          {groups.map((group) => (
            <option value={group}>{group}</option>
          ))}
        </select>
      </div>
      <button type="button" id="reset-search">
        Reset
      </button>
    </div>
    <p class="archive-count" id="repo-count" role="status" aria-live="polite">
      {repositories.length} repositories
    </p>
    <div class="repo-list">
      {entries.map((repo) => (
        <article
          class:list={[
            'repo-row',
            {
              'repo-row-preview':
                repo.projects.length === 1 && repo.projects[0].data.image,
            },
          ]}
          data-group={repo.group}
          data-search={`${repo.title} ${repo.name} ${repo.description} ${repo.language} ${repo.projects.map(({ data }) => `${data.title} ${data.description} ${data.tags.join(' ')}`).join(' ')}`.toLowerCase()}
        >
          <div class="repo-year">{repo.year}</div>
          {repo.projects.length === 1 && repo.projects[0].data.image && (
            <a
              class="repo-preview"
              href={pageLink(`projects/${repo.projects[0].id}/`)}
              aria-label={`Read about ${repo.projects[0].data.title}`}
            >
              <img
                src={withBase(repo.projects[0].data.image)}
                alt={
                  repo.projects[0].data.imageAlt ||
                  `${repo.projects[0].data.title} screenshot`
                }
                loading="lazy"
                decoding="async"
                width="640"
                height="400"
                style={{ objectFit: repo.projects[0].data.imageFit }}
              />
            </a>
          )}
          <div class="repo-description">
            <p class="eyebrow">{repo.group}</p>
            <h2>{repo.title}</h2>
            <p>{repo.description}</p>
            <span class="repo-language">{repo.language}</span>
          </div>
          <div class="repo-links">
            {repo.projects.length <= 1 && repo.caseStudy && (
              <a
                href={pageLink(`projects/${repo.caseStudy}/`)}
                aria-label={`Read about ${repo.title}`}
              >
                Project story ↗
              </a>
            )}
            {'demo' in repo && repo.demo && (
              <a
                href={String(repo.demo)}
                aria-label={`Open ${repo.title} demo`}
              >
                {repo.projects.length > 1 ? 'Collection home ↗' : 'Live demo ↗'}
              </a>
            )}
            <a
              href={repo.repository}
              aria-label={`View ${repo.title} source on GitHub`}
            >
              Source code ↗
            </a>
          </div>
          {repo.projects.length > 1 && (
            <section
              class="repo-projects"
              aria-label={`Projects in ${repo.title}`}
            >
              <p class="repo-projects-label">
                Inside this repository{' '}
                <span>{repo.projects.length} projects</span>
              </p>
              <div class="repo-project-grid">
                {repo.projects.map(({ id, data }) => (
                  <div class="repo-project-card">
                    {data.image && (
                      <a
                        class="repo-preview"
                        href={pageLink(`projects/${id}/`)}
                        aria-label={`Read about ${data.title}`}
                      >
                        <img
                          src={withBase(data.image)}
                          alt={data.imageAlt || `${data.title} screenshot`}
                          loading="lazy"
                          decoding="async"
                          width="640"
                          height="400"
                          style={{ objectFit: data.imageFit }}
                        />
                      </a>
                    )}
                    <h3>
                      <a href={pageLink(`projects/${id}/`)}>{data.title}</a>
                    </h3>
                    <p>{data.description}</p>
                    <div class="repo-project-actions">
                      <a
                        href={pageLink(`projects/${id}/`)}
                        aria-label={`Read ${data.title} project story`}
                      >
                        Project story ↗
                      </a>
                      {data.demo && (
                        <a
                          href={data.demo}
                          aria-label={`Open ${data.title} demo`}
                        >
                          Live demo ↗
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}
        </article>
      ))}
    </div>
    <p class="archive-empty" hidden>
      No matching projects. Try another search or reset the filters.
    </p>
    <p class="archive-footnote">
      Live demo links are included where a deployment was verified. Other
      entries link to their source. Course collections and older experiments may
      contain unfinished work or original starter code.
    </p>
  </section>
</Layout>
<script>
  const controls = document.querySelector<HTMLElement>('.archive-controls');
  const search = document.querySelector<HTMLInputElement>('#repo-search');
  const group = document.querySelector<HTMLSelectElement>('#repo-group');
  const reset = document.querySelector<HTMLButtonElement>('#reset-search');
  const rows = document.querySelectorAll<HTMLElement>('.repo-row');
  const count = document.querySelector<HTMLElement>('#repo-count');
  const empty = document.querySelector<HTMLElement>('.archive-empty');
  function filter() {
    const terms = (search?.value.trim().toLowerCase() || '')
      .split(/\s+/)
      .filter(Boolean);
    let visible = 0;
    rows.forEach((row) => {
      row.hidden = !(
        terms.every((term) => row.dataset.search?.includes(term)) &&
        (group?.value === 'all' || row.dataset.group === group?.value)
      );
      if (!row.hidden) visible++;
    });
    if (count)
      count.textContent = `${visible} ${visible === 1 ? 'repository' : 'repositories'}`;
    if (empty) empty.hidden = visible > 0;
  }
  if (controls) controls.hidden = false;
  search?.addEventListener('input', filter);
  group?.addEventListener('change', filter);
  reset?.addEventListener('click', () => {
    if (search) search.value = '';
    if (group) group.value = 'all';
    filter();
    search?.focus();
  });
</script>
