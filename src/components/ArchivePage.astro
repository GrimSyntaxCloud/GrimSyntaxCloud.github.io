---
import ArrowIcon from './ArrowIcon.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import repositories from '../data/repositories.json';
import { designPath, withBase, type Design } from '../lib/paths';
import { profile } from '../data/profile';
import {
  projectFilters,
  focusOptions,
  featureOptions,
} from '../data/project-filters';
import type { ArchiveCandidate } from '../lib/archive-filter';
interface Props {
  variant?: Design;
}
const { variant = 'editorial' } = Astro.props;
const pageLink = (path = '') => designPath(variant, path);
const groups = [...new Set(repositories.map((repo) => repo.group))];
const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const repositoryKey = (url: string) => url.replace(/\/$/, '').toLowerCase();
// Share project images and destinations with the main portfolio so they stay current.
const entries = repositories.map((repo) => ({
  ...repo,
  projects: projects.filter(
    (project) =>
      project.data.repository &&
      repositoryKey(project.data.repository) === repositoryKey(repo.repository),
  ),
}));
const availabilityOptions = {
  live: 'Live demo',
  source: 'Source code',
  story: 'Project write-up',
};
const candidatesFor = (repo: (typeof entries)[number]): ArchiveCandidate[] => {
  if (!repo.projects.length)
    return [
      {
        id: repo.name,
        search:
          `${repo.title} ${repo.name} ${repo.description} ${repo.language}`.toLowerCase(),
        focus: [],
        features: [],
        technologies: [repo.language],
        availability: ['source', ...(repo.demo ? ['live'] : [])],
      },
    ];
  return repo.projects.map(({ id, data }) => {
    const filters = projectFilters[id];
    if (!filters) throw new Error(`Missing reviewed archive filters for ${id}`);
    return {
      id,
      ...filters,
      search:
        `${repo.title} ${repo.name} ${data.title} ${data.description} ${data.tags.join(' ')} ${filters.technologies.join(' ')} ${filters.note || ''}`.toLowerCase(),
      availability: [
        'source',
        'story',
        ...(data.demo || id === 'portfolio' ? ['live'] : []),
      ],
    };
  });
};
const technologies = [
  ...new Set(
    entries.flatMap((repo) =>
      candidatesFor(repo).flatMap((project) => project.technologies),
    ),
  ),
].sort();
---

<Layout
  variant={variant}
  pagePath="archive/"
  title={`Project archive — ${profile.name}`}
  description="Explore my applications, browser experiments, design studies, and development coursework."
>
  <section class="archive-section" aria-labelledby="archive-title">
    <a class="text-link back-link" href={pageLink('#work')}>
      <ArrowIcon direction="left" /> Selected work
    </a>
    <header class="archive-header reveal">
      <p class="eyebrow">THE WORK, THE PRACTICE, THE PROCESS</p>
      <div class="archive-heading">
        <h1 id="archive-title">
          Project archive<span>.</span>
        </h1>
        <div class="archive-emblem" aria-hidden="true">
          <span>
            <ArrowIcon />
          </span>
          <span>
            <ArrowIcon />
          </span>
          <span>
            <ArrowIcon />
          </span>
        </div>
      </div>
      <p>
        A broader look at my work: applications, small experiments, and the
        coursework behind them. Earlier exercises are included as part of the
        learning process.
      </p>
      <p class="archive-guide">
        Browse the screenshots, open a project story, or jump straight into a
        live demo. Shared repositories include individual projects below.
      </p>
    </header>
    <div class="archive-filter-panel" hidden>
      <div class="archive-controls">
        <div class="archive-search">
          <label for="repo-search">Search projects</label>
          <input
            id="repo-search"
            type="search"
            placeholder="Search by name, technology, or topic…"
            autocomplete="off"
          />
        </div>
        <div>
          <label for="repo-group">Collection</label>
          <select id="repo-group">
            <option value="all">All collections</option>
            {groups.map((group) => (
              <option value={group}>{group}</option>
            ))}
          </select>
        </div>
        <button type="button" id="reset-search">
          Clear all
        </button>
      </div>
      <div class="archive-quick" role="group" aria-label="Quick filters">
        <span class="archive-filter-caption">Start here</span>
        <button type="button" data-quick="live" aria-pressed="false">
          Live demos
        </button>
        <button type="button" data-quick="full-stack" aria-pressed="false">
          Full stack
        </button>
        <button type="button" data-quick="frontend" aria-pressed="false">
          Frontend
        </button>
        <label class="archive-coursework">
          <input id="include-coursework" type="checkbox" /> Include coursework
        </label>
      </div>
      <details class="archive-more">
        <summary>
          More filters <span id="more-filter-count"></span>
        </summary>
        <div class="archive-filter-grid">
          <div>
            <label for="filter-technology">Technology</label>
            <select id="filter-technology">
              <option value="">Any technology</option>
              {technologies.map((value) => (
                <option value={value}>{value}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-focus">Project focus</label>
            <select id="filter-focus">
              <option value="">Any focus</option>
              {Object.entries(focusOptions).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-feature">Feature demonstrated</label>
            <select id="filter-feature">
              <option value="">Any feature</option>
              {Object.entries(featureOptions).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </div>
          <div>
            <label for="filter-availability">Availability</label>
            <select id="filter-availability">
              <option value="">Any availability</option>
              {Object.entries(availabilityOptions).map(([value, label]) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          </div>
        </div>
        <p class="archive-filter-help">
          Filters combine to find the same project. Frontend means a browser or
          static-site app; full stack includes a working server. PHP original
          editions are labeled separately.
        </p>
      </details>
      <div
        id="active-filters"
        class="archive-active"
        role="group"
        aria-label="Selected filters"
      ></div>
    </div>
    <p class="archive-count" id="repo-count" role="status" aria-live="polite">
      {repositories.length} repositories
    </p>
    <div class="repo-list">
      {entries.map((repo) => (
        <article
          class:list={[
            'repo-row',
            {
              'repo-row-preview':
                repo.projects.length === 1 && repo.projects[0].data.image,
            },
          ]}
          data-group={repo.group}
          data-candidates={JSON.stringify(candidatesFor(repo))}
        >
          <div class="repo-year">{repo.year}</div>
          {repo.projects.length === 1 && repo.projects[0].data.image && (
            <a
              class="repo-preview"
              href={pageLink(`projects/${repo.projects[0].id}/`)}
              aria-label={`Read about ${repo.projects[0].data.title}`}
            >
              <img
                src={withBase(repo.projects[0].data.image)}
                alt={
                  repo.projects[0].data.imageAlt ||
                  `${repo.projects[0].data.title} screenshot`
                }
                loading="lazy"
                decoding="async"
                width="640"
                height="400"
                style={{ objectFit: repo.projects[0].data.imageFit }}
              />
            </a>
          )}
          <div class="repo-description">
            <p class="eyebrow">{repo.group}</p>
            <h2>{repo.title}</h2>
            <p>{repo.description}</p>
            <span class="repo-language">{repo.language}</span>
            {repo.projects.length === 1 && (
              <div class="archive-project-facts">
                <p>
                  {[
                    ...projectFilters[repo.projects[0].id].focus.map(
                      (key) => focusOptions[key],
                    ),
                    ...projectFilters[repo.projects[0].id].features.map(
                      (key) => featureOptions[key],
                    ),
                  ].join(' · ')}
                </p>
                {projectFilters[repo.projects[0].id].note && (
                  <p class="archive-project-note">
                    {projectFilters[repo.projects[0].id].note}
                  </p>
                )}
              </div>
            )}
          </div>
          <div class="repo-links">
            {repo.projects.length <= 1 && repo.caseStudy && (
              <a
                href={pageLink(`projects/${repo.caseStudy}/`)}
                aria-label={`Read about ${repo.title}`}
              >
                Project story <ArrowIcon />
              </a>
            )}
            {(repo.demo || repo.caseStudy === 'portfolio') && (
              <a
                href={
                  repo.caseStudy === 'portfolio'
                    ? pageLink()
                    : String(repo.demo)
                }
                aria-label={`Open ${repo.title} demo`}
              >
                {repo.projects.length > 1 ? 'Collection home' : 'Live demo'}{' '}
                <ArrowIcon />
              </a>
            )}
            <a
              href={repo.repository}
              aria-label={`View ${repo.title} source on GitHub`}
            >
              Source code <ArrowIcon />
            </a>
          </div>
          {repo.projects.length > 1 && (
            <section
              class="repo-projects"
              aria-label={`Projects in ${repo.title}`}
            >
              <p class="repo-projects-label">
                Inside this repository{' '}
                <span class="repo-matched-count">
                  {repo.projects.length} projects
                </span>
              </p>
              <div class="repo-project-grid">
                {repo.projects.map(({ id, data }) => (
                  <div class="repo-project-card" data-project-id={id}>
                    {data.image && (
                      <a
                        class="repo-preview"
                        href={pageLink(`projects/${id}/`)}
                        aria-label={`Read about ${data.title}`}
                      >
                        <img
                          src={withBase(data.image)}
                          alt={data.imageAlt || `${data.title} screenshot`}
                          loading="lazy"
                          decoding="async"
                          width="640"
                          height="400"
                          style={{ objectFit: data.imageFit }}
                        />
                      </a>
                    )}
                    <h3>
                      <a href={pageLink(`projects/${id}/`)}>{data.title}</a>
                    </h3>
                    <p>{data.description}</p>
                    <div class="archive-project-facts">
                      <p>
                        {[
                          ...projectFilters[id].focus.map(
                            (key) => focusOptions[key],
                          ),
                          ...projectFilters[id].features.map(
                            (key) => featureOptions[key],
                          ),
                        ].join(' · ')}
                      </p>
                      {projectFilters[id].note && (
                        <p class="archive-project-note">
                          {projectFilters[id].note}
                        </p>
                      )}
                    </div>
                    <div class="repo-project-actions">
                      <a
                        href={pageLink(`projects/${id}/`)}
                        aria-label={`Read ${data.title} project story`}
                      >
                        Project story <ArrowIcon />
                      </a>
                      {data.demo && (
                        <a
                          href={data.demo}
                          aria-label={`Open ${data.title} demo`}
                        >
                          Live demo <ArrowIcon />
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}
        </article>
      ))}
    </div>
    <p class="archive-empty" hidden>
      No matching projects. Try another search or reset the filters.
    </p>
    <p class="archive-footnote">
      Live demo links are included where a deployment was verified. Other
      entries link to their source. Course collections and older experiments may
      contain unfinished work or original starter code.
    </p>
  </section>
</Layout>
<script>
  import {
    matchesArchiveCandidate,
    type ArchiveCandidate,
    type ArchiveSelection,
  } from '../lib/archive-filter';
  const panel = document.querySelector<HTMLElement>('.archive-filter-panel');
  const search = document.querySelector<HTMLInputElement>('#repo-search')!;
  const group = document.querySelector<HTMLSelectElement>('#repo-group')!;
  const coursework = document.querySelector<HTMLInputElement>(
    '#include-coursework',
  )!;
  const reset = document.querySelector<HTMLButtonElement>('#reset-search')!;
  const selects = {
    technology:
      document.querySelector<HTMLSelectElement>('#filter-technology')!,
    focus: document.querySelector<HTMLSelectElement>('#filter-focus')!,
    feature: document.querySelector<HTMLSelectElement>('#filter-feature')!,
    availability: document.querySelector<HTMLSelectElement>(
      '#filter-availability',
    )!,
  };
  const quick = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-quick]'),
  ];
  const rows = [...document.querySelectorAll<HTMLElement>('.repo-row')].map(
    (row) => ({
      row,
      candidates: JSON.parse(
        row.dataset.candidates || '[]',
      ) as ArchiveCandidate[],
    }),
  );
  const count = document.querySelector<HTMLElement>('#repo-count')!;
  const empty = document.querySelector<HTMLElement>('.archive-empty')!;
  const active = document.querySelector<HTMLElement>('#active-filters')!;
  const moreCount = document.querySelector<HTMLElement>('#more-filter-count')!;
  function filter() {
    const selection: ArchiveSelection = {
      search: search.value,
      group: group.value,
      coursework: coursework.checked,
      technology: selects.technology.value,
      focus: selects.focus.value,
      feature: selects.feature.value,
      availability: selects.availability.value,
    };
    let visible = 0;
    rows.forEach(({ row, candidates }) => {
      const matches = candidates.filter((candidate) =>
        matchesArchiveCandidate(candidate, row.dataset.group || '', selection),
      );
      row.hidden = matches.length === 0;
      if (!row.hidden) visible++;
      row.querySelectorAll<HTMLElement>('[data-project-id]').forEach((card) => {
        card.hidden = !matches.some(
          (candidate) => candidate.id === card.dataset.projectId,
        );
      });
      const matchedCount = row.querySelector('.repo-matched-count');
      if (matchedCount)
        matchedCount.textContent =
          matches.length === candidates.length
            ? `${matches.length} projects`
            : `${matches.length} of ${candidates.length} projects match`;
    });
    count.textContent = `${visible} ${visible === 1 ? 'repository' : 'repositories'}${coursework.checked ? '' : ' · coursework hidden'}`;
    empty.hidden = visible > 0;
    quick.forEach((button) =>
      button.setAttribute(
        'aria-pressed',
        String(
          button.dataset.quick === 'live'
            ? selection.availability === 'live'
            : selection.focus === button.dataset.quick,
        ),
      ),
    );
    const selectedCount = Object.values(selects).filter(
      (select) => select.value,
    ).length;
    moreCount.textContent = selectedCount ? `(${selectedCount} selected)` : '';
    active.replaceChildren();
    const chip = (label: string, clear: () => void) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = `${label} ×`;
      button.setAttribute('aria-label', `Remove filter: ${label}`);
      button.addEventListener('click', () => {
        clear();
        filter();
        search.focus();
      });
      active.append(button);
    };
    if (search.value.trim())
      chip(`Search: ${search.value.trim()}`, () => (search.value = ''));
    if (group.value !== 'all')
      chip(`Collection: ${group.value}`, () => (group.value = 'all'));
    if (!coursework.checked)
      chip('Coursework excluded', () => (coursework.checked = true));
    Object.entries(selects).forEach(([key, select]) => {
      if (select.value)
        chip(
          `${key === 'feature' ? 'Feature' : key === 'technology' ? 'Technology' : key === 'focus' ? 'Focus' : 'Availability'}: ${select.selectedOptions[0].textContent}`,
          () => (select.value = ''),
        );
    });
  }
  search.addEventListener('input', filter);
  group.addEventListener('change', () => {
    // Selecting Coursework should show it without a second, contradictory control.
    if (group.value === 'Coursework') coursework.checked = true;
    filter();
  });
  coursework.addEventListener('change', () => {
    if (!coursework.checked && group.value === 'Coursework')
      group.value = 'all';
    filter();
  });
  Object.values(selects).forEach((select) =>
    select.addEventListener('change', filter),
  );
  quick.forEach((button) =>
    button.addEventListener('click', () => {
      const select =
        button.dataset.quick === 'live' ? selects.availability : selects.focus;
      const value = button.dataset.quick!;
      select.value = select.value === value ? '' : value;
      filter();
    }),
  );
  reset.addEventListener('click', () => {
    search.value = '';
    group.value = 'all';
    coursework.checked = true;
    Object.values(selects).forEach((select) => (select.value = ''));
    filter();
    search.focus();
  });
  filter();
  if (panel) panel.hidden = false;
</script>
