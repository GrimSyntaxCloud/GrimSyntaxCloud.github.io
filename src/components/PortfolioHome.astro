---
import { getCollection } from 'astro:content';
import { profile } from '../data/profile';
import repositories from '../data/repositories.json';
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import { designPath } from '../lib/paths';
interface Props {
  variant: 'editorial' | 'industrial';
}
const { variant } = Astro.props;
const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const featuredIds = ['trivia-turbo', 'bcrs', 'nodebucket'];
const featured = featuredIds.map((id) => projects.find((p) => p.id === id)!);
const remaining = projects.filter((p) => !featuredIds.includes(p.id));
const projectFilters = [
  { label: 'All projects', value: 'all', count: projects.length },
  {
    label: 'Web apps',
    value: 'Web app',
    count: projects.filter((p) => p.data.category === 'Web app').length,
  },
  {
    label: 'Built with AI',
    value: 'built-with-ai',
    count: projects.filter((p) => p.data.builtWithAI).length,
  },
];
const pageLink = (path = '') => designPath(variant, path);
---

<Layout variant={variant} pagePath="">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-topline">
      <p class="eyebrow">
        <span class="status-dot"></span> A WORK IN PROGRESS. ALWAYS.
      </p>
      <span class="edition" aria-hidden="true">
        {variant === 'editorial'
          ? 'THE BUILDER’S NOTEBOOK / NO. 001'
          : 'AMDEV / THE BUILDER’S NOTEBOOK'}
      </span>
    </div>
    <div class="hero-copy">
      <h1 id="hero-title">
        <span class="headline-first">{profile.headline[0]}</span>
        <span class="headline-second">
          {profile.headline[1]} <em>{profile.headline[2]}</em>
        </span>
      </h1>
      <div class="hero-bottom">
        <p>{profile.intro}</p>
        <a class="button" href="#work">
          Explore my work <span aria-hidden="true">↘</span>
        </a>
      </div>
    </div>
    <div class="sculpture" data-sculpture={variant} aria-hidden="true">
      <div class="sculpture-fallback">
        <span>THINK.</span>
        <span>BUILD.</span>
        <span>LEARN.</span>
      </div>
      <canvas></canvas>
      <span class="scene-caption">IDEAS INTO SOMETHING REAL.</span>
      <span class="scene-coordinate">
        {variant === 'editorial' ? 'FORM / 001' : 'X 01 / Y 02 / Z 03'}
      </span>
    </div>
    <div class="hero-footnote" aria-hidden="true">
      <span>WEB DEVELOPMENT & AI</span>
      <span>SCROLL TO EXPLORE ↓</span>
    </div>
  </section>
  <div
    class="manifesto"
    aria-label="Think it. Build it. Learn from it. A little better, every iteration."
  >
    <div class="manifesto-line" aria-hidden="true">
      <span>
        <small>01</small> THINK IT.
      </span>
      <span>
        <small>02</small> BUILD IT.
      </span>
      <span>
        <small>03</small> LEARN FROM IT.
      </span>
    </div>
    <p aria-hidden="true">A little better, every iteration. ↗</p>
  </div>
  <section id="work" class="work-section" aria-labelledby="work-title">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">01 / THE COLLECTION</p>
        <h2 id="work-title">
          Selected work{' '}
          <span>({String(projects.length).padStart(2, '0')})</span>
        </h2>
      </div>
      <p>
        From a first idea to a working project.
        <br />
        Here’s what I’ve been building.
      </p>
    </div>
    <div
      class="project-filters"
      role="group"
      aria-label="Filter projects"
      hidden
    >
      {projectFilters.map((filter, i) => (
        <button type="button" data-filter={filter.value} aria-pressed={i === 0}>
          {filter.label}
          <span>{filter.count}</span>
        </button>
      ))}
    </div>
    <div class="featured-projects">
      {featured.map((project, index) => (
        <article
          class={`featured-project reveal project-${project.id}`}
          data-category={project.data.category}
          data-built-with-ai={String(project.data.builtWithAI)}
        >
          <a
            class="project-visual"
            href={pageLink(`projects/${project.id}/`)}
            aria-label={`Read about ${project.data.title}`}
          >
            {project.data.image ? (
              <img
                src={withBase(project.data.image)}
                alt={project.data.imageAlt || project.data.title}
                width="1280"
                height="720"
                loading="lazy"
              />
            ) : (
              <div class="type-art" aria-hidden="true">
                <span class="type-art-index">0{index + 1}</span>
                <strong>
                  {project.data.title === 'Nodebucket'
                    ? 'node\nbucket'
                    : 'BCRS'}
                </strong>
                <span class="type-art-stack">
                  {project.data.tags.join(' / ')}
                </span>
                <div class="construction-lines"></div>
              </div>
            )}
            <span class="visual-caption">
              {project.data.image
                ? 'GAMEPLAY / TRIVIA TURBO'
                : 'PROJECT / ' + project.data.title}
            </span>
            <span class="cover-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
          <div class="project-copy">
            <p class="project-meta">
              0{index + 1} / {project.data.category}
              <span>{project.data.year}</span>
            </p>
            <h3>
              <a href={pageLink(`projects/${project.id}/`)}>
                {project.data.title}
              </a>
            </h3>
            <p class="project-description">{project.data.description}</p>
            <ul class="tags" aria-label="Technologies">
              {project.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <div class="card-links">
              {project.data.demo && (
                <a class="button" href={project.data.demo}>
                  Live demo <span>↗</span>
                </a>
              )}
              {project.data.repository && (
                <a class="text-link" href={project.data.repository}>
                  Source code ↗
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="project-index">
      {remaining.map((project, i) => (
        <article
          class="index-row reveal"
          data-category={project.data.category}
          data-built-with-ai={String(project.data.builtWithAI)}
        >
          <span class="index-number">{String(i + 4).padStart(2, '0')}</span>
          <div>
            <h3>
              <a href={pageLink(`projects/${project.id}/`)}>
                {project.data.title}
              </a>
            </h3>
            <p>{project.data.description}</p>
          </div>
          <div class="index-links">
            {project.data.demo && <a href={project.data.demo}>Live demo ↗</a>}
            {project.data.repository && (
              <a href={project.data.repository}>Source code ↗</a>
            )}
          </div>
          <span class="index-year">{project.data.year}</span>
        </article>
      ))}
    </div>
    <p class="filter-empty" hidden>
      No projects in this category yet. More experiments are on the way.
    </p>
    <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
    <a class="text-link archive-link" href={pageLink('archive/')}>
      Browse all {repositories.length} repositories ↗
    </a>
  </section>
  <section
    id="about"
    class="about-section reveal"
    aria-labelledby="about-title"
  >
    <div>
      <p class="eyebrow">02 / BEHIND THE CODE</p>
      <h2 id="about-title">
        Curiosity is
        <br />
        the starting point<span>.</span>
      </h2>
      <div class="about-object" aria-hidden="true">
        <span>?</span>
        <span>↗</span>
      </div>
    </div>
    <div class="about-copy">
      <p class="about-lead">{profile.about}</p>
      <p>
        My interests meet where useful interfaces and new possibilities overlap.
        Some projects solve everyday problems. Others start with a simple “what
        if?”
      </p>
      <div class="toolbox">
        <p class="eyebrow">IN MY TOOLBOX</p>
        <ul>
          {profile.tools.map((tool) => (
            <li>{tool}</li>
          ))}
        </ul>
      </div>
      <p class="ai-note">
        AI is part of my development process. The project write-ups are a place
        to document the tools, decisions, and lessons behind the code.
      </p>
    </div>
  </section>
  <section class="contact-section reveal" aria-labelledby="contact-title">
    <p class="eyebrow">03 / KEEP IN TOUCH</p>
    <h2 id="contact-title">
      Good things start
      <br />
      with a conversation.
    </h2>
    <a
      class="contact-link"
      href={profile.email ? `mailto:${profile.email}` : profile.github}
    >
      {profile.email ? 'Say hello' : 'Find me on GitHub'}{' '}
      <span aria-hidden="true">↗</span>
    </a>
  </section>
</Layout>
