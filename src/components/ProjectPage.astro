---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectTrailer from './ProjectTrailer.astro';
import { withBase, designPath, type Design } from '../lib/paths';
import { profile } from '../data/profile';
interface Props {
  project: CollectionEntry<'projects'>;
  variant?: Design;
}
const { project, variant = 'editorial' } = Astro.props;
const pageLink = (path = '') => designPath(variant, path);
const { Content } = await render(project);
const { data } = project;
---

<Layout
  variant={variant}
  pagePath={`projects/${project.id}/`}
  title={`${data.title} — ${profile.name}`}
  description={data.description}
>
  <article class="case-study">
    <a class="text-link back-link" href={pageLink('#work')}>
      ← All projects
    </a>
    <header class="case-header reveal">
      <p class="eyebrow">
        {data.category} / {data.year}
      </p>
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      <div class="case-actions">
        {data.repository && (
          <a class="button" href={data.repository}>
            View source <span aria-hidden="true">↗</span>
          </a>
        )}
        {data.demo && (
          <a class="button button-outline" href={data.demo}>
            Live demo <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </header>
    {data.trailer ? (
      <ProjectTrailer
        title={data.title}
        trailer={data.trailer}
        poster={data.image}
      />
    ) : (
      <div class="case-cover">
        {data.image ? (
          <img
            src={withBase(data.image)}
            alt={data.imageAlt || data.title}
            width="1200"
            height="700"
          />
        ) : (
          <div class="story-art" aria-hidden="true">
            <span class="eyebrow">FROM IDEA TO INTERFACE / {data.year}</span>
            <strong>{data.title}</strong>
            <span class="story-art-arrow">↗</span>
            <span class="eyebrow">THINK. BUILD. LEARN.</span>
          </div>
        )}
      </div>
    )}
    <div class="case-body">
      <aside class="case-facts">
        <div>
          <p class="eyebrow">PROJECT TYPE</p>
          <p>{data.category}</p>
          {data.builtWithAI && <span class="ai-badge">Built with AI</span>}
        </div>
        <div>
          <p class="eyebrow">STATUS</p>
          <p>{data.status}</p>
        </div>
        <div>
          <p class="eyebrow">BUILT WITH</p>
          <ul class="tags">
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
    {data.screenshots.length > 0 && (
      <section class="case-gallery" aria-labelledby="screenshots-title">
        <div class="gallery-heading">
          <p class="eyebrow">
            {data.demo && data.status === 'Live'
              ? 'FROM THE LIVE DEMO'
              : 'FROM THE WORKING PREVIEW'}
          </p>
          <h2 id="screenshots-title">A closer look.</h2>
          <p>Open a screenshot to see it at full size.</p>
        </div>
        <div class="screenshot-grid">
          {data.screenshots.map((shot) => (
            <figure>
              <a
                href={withBase(shot.src)}
                aria-label={`Open full-size screenshot: ${shot.alt}`}
              >
                <img
                  src={withBase(shot.src)}
                  alt={shot.alt}
                  width={shot.width}
                  height={shot.height}
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <figcaption>{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}
    <div class="case-end">
      <span>Thanks for taking a look.</span>
      <a class="text-link" href={pageLink('#work')}>
        Back to the collection ↗
      </a>
    </div>
  </article>
</Layout>
