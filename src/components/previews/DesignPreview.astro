---
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';
import repositories from '../../data/repositories.json';
import { withBase } from '../../lib/paths';
import '../../styles/previews/design-preview.css';
interface Props {
  variant: 'editorial' | 'industrial';
}
const { variant } = Astro.props;
const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
const featuredIds = ['trivia-turbo', 'bcrs', 'nodebucket'];
const featured = featuredIds.map((id) => projects.find((p) => p.id === id)!);
const remaining = projects.filter((p) => !featuredIds.includes(p.id));
const name = variant === 'editorial' ? 'Editorial' : 'Industrial';
---

<!doctype html>
<html lang="en" data-design={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{name} preview — {profile.name}</title>
    <meta name="description" content={profile.intro} />
    <link rel="icon" href={withBase('favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <aside class="preview-bar" aria-label="Design preview controls">
      <span class="preview-label">LOCAL DESIGN PREVIEW</span>
      <nav aria-label="Compare designs">
        <a
          href={withBase('previews/editorial/')}
          aria-current={variant === 'editorial' ? 'page' : undefined}
        >
          01 Editorial
        </a>
        <a
          href={withBase('previews/industrial/')}
          aria-current={variant === 'industrial' ? 'page' : undefined}
        >
          02 Industrial
        </a>
      </nav>
      <button class="motion-toggle" type="button" aria-pressed="false" hidden>
        Pause motion
      </button>
    </aside>
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="#" aria-label={`${profile.name} home`}>
          <span class="brand-mark" aria-hidden="true">
            a↗
          </span>
          {profile.name}
          <small>{profile.role}</small>
        </a>
        <nav aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href={withBase('archive/')}>Archive</a>
          <a href="#about">About</a>
          <a class="nav-github" href={profile.github}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-topline">
            <p class="eyebrow">
              <span class="status-dot"></span> A WORK IN PROGRESS. ALWAYS.
            </p>
            <span class="edition" aria-hidden="true">
              {variant === 'editorial'
                ? 'THE BUILDER’S NOTEBOOK / NO. 001'
                : 'AMDEV / THE BUILDER’S NOTEBOOK'}
            </span>
          </div>
          <div class="hero-copy">
            <h1 id="hero-title">
              <span class="headline-first">{profile.headline[0]}</span>
              <span class="headline-second">
                {profile.headline[1]} <em>{profile.headline[2]}</em>
              </span>
            </h1>
            <div class="hero-bottom">
              <p>{profile.intro}</p>
              <a class="button" href="#work">
                Explore my work <span aria-hidden="true">↘</span>
              </a>
            </div>
          </div>
          <div class="sculpture" data-sculpture={variant} aria-hidden="true">
            <div class="sculpture-fallback">
              <span>THINK.</span>
              <span>BUILD.</span>
              <span>LEARN.</span>
            </div>
            <canvas></canvas>
            <span class="scene-caption">IDEAS INTO SOMETHING REAL.</span>
            <span class="scene-coordinate">
              {variant === 'editorial' ? 'FORM / 001' : 'X 01 / Y 02 / Z 03'}
            </span>
          </div>
          <div class="hero-footnote" aria-hidden="true">
            <span>WEB DEVELOPMENT & AI</span>
            <span>SCROLL TO EXPLORE ↓</span>
          </div>
        </section>
        <div
          class="manifesto"
          aria-label="Think it. Build it. Learn from it. A little better, every iteration."
        >
          <div class="manifesto-line" aria-hidden="true">
            <span>
              <small>01</small> THINK IT.
            </span>
            <span>
              <small>02</small> BUILD IT.
            </span>
            <span>
              <small>03</small> LEARN FROM IT.
            </span>
          </div>
          <p aria-hidden="true">A little better, every iteration. ↗</p>
        </div>
        <section id="work" class="work-section" aria-labelledby="work-title">
          <div class="section-heading reveal">
            <div>
              <p class="eyebrow">01 / THE COLLECTION</p>
              <h2 id="work-title">
                Selected work{' '}
                <span>({String(projects.length).padStart(2, '0')})</span>
              </h2>
            </div>
            <p>
              From a first idea to a working project.
              <br />
              Here’s what I’ve been building.
            </p>
          </div>
          <div
            class="project-filters"
            role="group"
            aria-label="Filter projects"
            hidden
          >
            {['All projects', 'Web apps', 'AI projects'].map((label, i) => (
              <button
                type="button"
                data-filter={['all', 'Web app', 'AI project'][i]}
                aria-pressed={i === 0}
              >
                {label}
                <span>
                  {i === 0
                    ? projects.length
                    : projects.filter(
                        (p) =>
                          p.data.category === ['Web app', 'AI project'][i - 1],
                      ).length}
                </span>
              </button>
            ))}
          </div>
          <div class="featured-projects">
            {featured.map((project, index) => (
              <article
                class={`featured-project reveal project-${project.id}`}
                data-category={project.data.category}
              >
                <a
                  class="project-visual"
                  href={withBase(`projects/${project.id}/`)}
                  aria-label={`Read about ${project.data.title}`}
                >
                  {project.data.image ? (
                    <img
                      src={withBase(project.data.image)}
                      alt={project.data.imageAlt || project.data.title}
                      width="1280"
                      height="720"
                      loading="lazy"
                    />
                  ) : (
                    <div class="type-art" aria-hidden="true">
                      <span class="type-art-index">0{index + 1}</span>
                      <strong>
                        {project.data.title === 'Nodebucket'
                          ? 'node\nbucket'
                          : 'BCRS'}
                      </strong>
                      <span class="type-art-stack">
                        {project.data.tags.join(' / ')}
                      </span>
                      <div class="construction-lines"></div>
                    </div>
                  )}
                  <span class="visual-caption">
                    {project.data.image
                      ? 'GAMEPLAY / TRIVIA TURBO'
                      : 'PROJECT / ' + project.data.title}
                  </span>
                  <span class="cover-arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
                <div class="project-copy">
                  <p class="project-meta">
                    0{index + 1} / {project.data.category}
                    <span>{project.data.year}</span>
                  </p>
                  <h3>
                    <a href={withBase(`projects/${project.id}/`)}>
                      {project.data.title}
                    </a>
                  </h3>
                  <p class="project-description">{project.data.description}</p>
                  <ul class="tags" aria-label="Technologies">
                    {project.data.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                  <div class="card-links">
                    {project.data.demo && (
                      <a class="button" href={project.data.demo}>
                        Live demo <span>↗</span>
                      </a>
                    )}
                    {project.data.repository && (
                      <a class="text-link" href={project.data.repository}>
                        Source code ↗
                      </a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
          <div class="project-index">
            {remaining.map((project, i) => (
              <article
                class="index-row reveal"
                data-category={project.data.category}
              >
                <span class="index-number">
                  {String(i + 4).padStart(2, '0')}
                </span>
                <div>
                  <h3>
                    <a href={withBase(`projects/${project.id}/`)}>
                      {project.data.title}
                    </a>
                  </h3>
                  <p>{project.data.description}</p>
                </div>
                <div class="index-links">
                  {project.data.demo && (
                    <a href={project.data.demo}>Live demo ↗</a>
                  )}
                  {project.data.repository && (
                    <a href={project.data.repository}>Source code ↗</a>
                  )}
                </div>
                <span class="index-year">{project.data.year}</span>
              </article>
            ))}
          </div>
          <p class="filter-empty" hidden>
            No projects in this category yet. More experiments are on the way.
          </p>
          <p
            class="sr-only"
            id="filter-status"
            role="status"
            aria-live="polite"
          ></p>
          <a class="text-link archive-link" href={withBase('archive/')}>
            Browse all {repositories.length} repositories ↗
          </a>
        </section>
        <section
          id="about"
          class="about-section reveal"
          aria-labelledby="about-title"
        >
          <div>
            <p class="eyebrow">02 / BEHIND THE CODE</p>
            <h2 id="about-title">
              Curiosity is
              <br />
              the starting point<span>.</span>
            </h2>
            <div class="about-object" aria-hidden="true">
              <span>?</span>
              <span>↗</span>
            </div>
          </div>
          <div class="about-copy">
            <p class="about-lead">{profile.about}</p>
            <p>
              My interests meet where useful interfaces and new possibilities
              overlap. Some projects solve everyday problems. Others start with
              a simple “what if?”
            </p>
            <div class="toolbox">
              <p class="eyebrow">IN MY TOOLBOX</p>
              <ul>
                {profile.tools.map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
            </div>
            <p class="ai-note">
              AI is part of my development process. The project write-ups are a
              place to document the tools, decisions, and lessons behind the
              code.
            </p>
          </div>
        </section>
        <section class="contact-section reveal" aria-labelledby="contact-title">
          <p class="eyebrow">03 / KEEP IN TOUCH</p>
          <h2 id="contact-title">
            Good things start
            <br />
            with a conversation.
          </h2>
          <a
            class="contact-link"
            href={profile.email ? `mailto:${profile.email}` : profile.github}
          >
            {profile.email ? 'Say hello' : 'Find me on GitHub'}{' '}
            <span aria-hidden="true">↗</span>
          </a>
        </section>
      </main>
      <footer>
        <a href="#">{profile.name} ↗</a>
        <p>Built with curiosity. Made with Astro.</p>
        <a href={profile.github}>Find me on GitHub ↗</a>
      </footer>
    </div>
    <script>
      import '../../scripts/previews/design-preview';
    </script>
  </body>
</html>
