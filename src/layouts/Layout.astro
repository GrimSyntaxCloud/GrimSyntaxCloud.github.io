---
import { profile } from '../data/profile';
import { withBase, designPath, type Design } from '../lib/paths';
import '../styles/home.css';
import '../styles/pages.css';
interface Props {
  title?: string;
  description?: string;
  variant?: Design;
  pagePath?: string;
}
const {
  title = `${profile.name} — Web development & AI`,
  description = profile.intro,
  variant = 'editorial',
  pagePath = '',
} = Astro.props;
const pageLink = (path = '') => designPath(variant, path);
const canonical = new URL(withBase(pagePath), Astro.site);
---

<!doctype html>
<html lang="en" data-design={variant}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content={variant === 'editorial' ? '#fafaf7' : '#16191a'}
    />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <aside class="design-bar" aria-label="Design and motion controls">
      <span class="design-label">CHOOSE YOUR VIEW</span>
      <nav aria-label="Site design">
        <a
          href={designPath('editorial', pagePath)}
          aria-current={variant === 'editorial' ? 'page' : undefined}
        >
          01 Editorial
        </a>
        <a
          href={designPath('industrial', pagePath)}
          aria-current={variant === 'industrial' ? 'page' : undefined}
        >
          02 Industrial
        </a>
      </nav>
      <button class="motion-toggle" type="button" aria-pressed="false" hidden>
        Pause motion
      </button>
    </aside>
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="page-shell">
      <header class="site-header">
        <a
          class="wordmark"
          href={pageLink()}
          aria-label={`${profile.name} home`}
        >
          <span class="brand-mark" aria-hidden="true">
            a↗
          </span>
          {profile.name}
          <small>{profile.role}</small>
        </a>
        <nav aria-label="Main navigation">
          <a href={pageLink('#work')}>Work</a>
          <a
            href={pageLink('archive/')}
            aria-current={pagePath === 'archive/' ? 'page' : undefined}
          >
            Archive
          </a>
          <a href={pageLink('#about')}>About</a>
          <a class="nav-github" href={profile.github}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer>
        <a href={pageLink()}>{profile.name} ↗</a>
        <p>Built with curiosity. Made with Astro.</p>
        <a href={profile.github}>Find me on GitHub ↗</a>
      </footer>
    </div>
    <script>
      import '../scripts/home';
    </script>
  </body>
</html>
