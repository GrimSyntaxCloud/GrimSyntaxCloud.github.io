---
import ArrowIcon from '../components/ArrowIcon.astro';
import { profile } from '../data/profile';
import { withBase, designPath, type Design } from '../lib/paths';
import '../styles/home.css';
import '../styles/pages.css';
interface Props {
  title?: string;
  description?: string;
  variant?: Design;
  pagePath?: string;
}
const {
  title = `${profile.name} — Web development & AI`,
  description = profile.intro,
  variant = 'editorial',
  pagePath = '',
} = Astro.props;
const pageLink = (path = '') => designPath(variant, path);
const designRoutes = {
  editorial: designPath('editorial', pagePath),
  industrial: designPath('industrial', pagePath),
};
const preferenceKey = `amdev:design:${withBase()}`;
const canonical = new URL(withBase(pagePath), Astro.site);
---

<!doctype html>
<html lang="en" data-design={variant}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ variant, designRoutes, preferenceKey }}>
      // Apply the preference before rendering; only redirect known portfolio routes.
      try {
        const saved = localStorage.getItem(preferenceKey);
        const currentPath = location.pathname.replace(/\/$/, '');
        const expectedPath = designRoutes[variant].replace(/\/$/, '');
        if (
          (saved === 'editorial' || saved === 'industrial') &&
          saved !== variant &&
          currentPath === expectedPath
        ) {
          location.replace(
            designRoutes[saved] + location.search + location.hash,
          );
        }
      } catch {
        // Navigation still works when browser storage is unavailable.
      }
      document.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        )
          return;
        const link =
          event.target instanceof Element
            ? event.target.closest('a[data-design-choice]')
            : null;
        const choice = link?.dataset.designChoice;
        if (choice !== 'editorial' && choice !== 'industrial') return;
        try {
          localStorage.setItem(preferenceKey, choice);
        } catch {}
        // Keep the same section when switching a project story or homepage.
        link.href = designRoutes[choice] + location.search + location.hash;
      });
    </script>
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content={variant === 'editorial' ? '#fafaf7' : '#16191a'}
    />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <aside class="design-bar" aria-label="Design and motion controls">
      <span class="design-label">CHOOSE YOUR VIEW</span>
      <nav aria-label="Site design">
        <a
          href={designRoutes.editorial}
          data-design-choice="editorial"
          aria-current={variant === 'editorial' ? 'page' : undefined}
        >
          <span class="design-index">01 </span>Editorial
        </a>
        <a
          href={designRoutes.industrial}
          data-design-choice="industrial"
          aria-current={variant === 'industrial' ? 'page' : undefined}
        >
          <span class="design-index">02 </span>Industrial
        </a>
      </nav>
      <button class="motion-toggle" type="button" aria-pressed="false" hidden>
        Pause motion
      </button>
    </aside>
    <div class="reading-progress" aria-hidden="true"></div>
    <div class="page-shell">
      <header class="site-header">
        <a
          class="wordmark"
          href={pageLink()}
          aria-label={`${profile.name} home`}
        >
          <span class="brand-mark" aria-hidden="true">
            a<ArrowIcon />
          </span>
          {profile.name}
          <small>{profile.role}</small>
        </a>
        <nav aria-label="Main navigation">
          <a href={pageLink('#work')}>Work</a>
          <a
            href={pageLink('archive/')}
            aria-current={pagePath === 'archive/' ? 'page' : undefined}
          >
            Archive
          </a>
          <a href={pageLink('#about')}>About</a>
          <a class="nav-github" href={profile.github}>
            GitHub{' '}
            <span aria-hidden="true">
              <ArrowIcon />
            </span>
          </a>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer>
        <a href={pageLink()}>
          {profile.name} <ArrowIcon />
        </a>
        <p>Built with curiosity. Made with Astro.</p>
        <a href={profile.github}>
          Find me on GitHub <ArrowIcon />
        </a>
      </footer>
    </div>
    <script>
      import '../scripts/home';
    </script>
  </body>
</html>
