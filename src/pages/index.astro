---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import repositories from '../data/repositories.json';
import { withBase } from '../lib/paths';
const projects = (
  await getCollection('projects', ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> A WORK IN PROGRESS. ALWAYS.
      </p>
      <h1 id="hero-title">
        {profile.headline.map((line, index) => (
          <>
            {index > 0 && <br />}
            {index === 0 ? line : <span>{line}</span>}
          </>
        ))}
      </h1>
      <p class="hero-description">{profile.intro}</p>
      <a class="button" href="#work">
        Explore my work <span aria-hidden="true">↘</span>
      </a>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="art-topline">
        <span>THE BUILDER’S NOTEBOOK</span>
        <span>NO. 001</span>
      </div>
      <div class="orbit-field">
        <div class="orbit-ring ring-a"></div>
        <div class="orbit-ring ring-b"></div>
        <div class="orbit-ring ring-c"></div>
        <span class="orbit-label label-web">
          WEB
          <br />
          <b>&lt;/&gt;</b>
        </span>
        <span class="orbit-label label-ai">
          AI
          <br />
          <b>✳</b>
        </span>
        <div class="center-symbol">
          a<span>↗</span>
        </div>
        <span class="orbit-point point-a"></span>
        <span class="orbit-point point-b"></span>
        <span class="art-cross cross-a">+</span>
        <span class="art-cross cross-b">+</span>
      </div>
      <div class="art-bottomline">
        <span>
          IDEAS INTO
          <br />
          SOMETHING REAL.
        </span>
        <span class="art-star">✳</span>
      </div>
    </div>
  </section>

  <div class="intro-strip">
    <span>THINK IT.</span>
    <span>BUILD IT.</span>
    <span>LEARN FROM IT.</span>
    <span class="strip-note">A little better, every iteration. ↗</span>
  </div>

  <section id="work" class="work-section" aria-labelledby="work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / THE COLLECTION</p>
        <h2 id="work-title">
          Selected work
          <span class="count">
            ({String(projects.length).padStart(2, '0')})
          </span>
        </h2>
      </div>
      <p>
        From a first idea to a working project.
        <br /> Here’s what I’ve been building.
      </p>
    </div>
    <div
      class="project-filters"
      role="group"
      aria-label="Filter projects"
      hidden
    >
      {['All projects', 'Web apps', 'AI projects'].map((label, index) => (
        <button
          type="button"
          data-filter={['all', 'Web app', 'AI project'][index]}
          aria-pressed={index === 0}
        >
          {label}
          <span aria-hidden="true">
            {index === 0
              ? projects.length
              : projects.filter(
                  (p) =>
                    p.data.category === ['Web app', 'AI project'][index - 1],
                ).length}
          </span>
        </button>
      ))}
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
    <p class="filter-empty" hidden>
      No projects in this category yet. More experiments are on the way.
    </p>
    <p class="sr-only" id="filter-status" role="status" aria-live="polite"></p>
    <a class="text-link collection-link" href={withBase('archive/')}>
      Browse all {repositories.length} repositories{' '}
      <span aria-hidden="true">↗</span>
    </a>
  </section>

  <section id="about" class="about-section" aria-labelledby="about-title">
    <div class="about-heading">
      <p class="eyebrow">02 / BEHIND THE CODE</p>
      <h2 id="about-title">
        Curiosity is
        <br />
        the starting point<span>.</span>
      </h2>
      <span class="about-asterisk" aria-hidden="true">
        ✳
      </span>
    </div>
    <div class="about-copy">
      <p class="about-lead">{profile.about}</p>
      <p>
        My interests meet where useful interfaces and new possibilities overlap.
        Some projects solve everyday problems. Others start with a simple “what
        if?”
      </p>
      <div class="toolbox">
        <p class="eyebrow">IN MY TOOLBOX</p>
        <ul>
          {profile.tools.map((tool) => (
            <li>{tool}</li>
          ))}
        </ul>
      </div>
      <p class="ai-note">
        AI is part of my development process. The project write-ups are a place
        to document the tools, decisions, and lessons behind the code.
      </p>
    </div>
  </section>
  <section class="contact-section" aria-labelledby="contact-title">
    <div>
      <p class="eyebrow">03 / KEEP IN TOUCH</p>
      <h2 id="contact-title">
        Good things start
        <br />
        with a conversation.
      </h2>
    </div>
    <a
      class="contact-link"
      href={profile.email ? `mailto:${profile.email}` : profile.github}
    >
      {profile.email ? 'Say hello' : 'Find me on GitHub'}{' '}
      <span aria-hidden="true">↗</span>
    </a>
  </section>
</Layout>
<script>
  const filters = document.querySelector<HTMLElement>('.project-filters');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const empty = document.querySelector<HTMLElement>('.filter-empty');
  const status = document.querySelector<HTMLElement>('#filter-status');
  if (filters) filters.hidden = false;
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      let count = 0;
      buttons.forEach((other) =>
        other.setAttribute('aria-pressed', String(other === button)),
      );
      cards.forEach((card) => {
        card.hidden =
          button.dataset.filter !== 'all' &&
          card.dataset.category !== button.dataset.filter;
        if (!card.hidden) count++;
      });
      if (empty) empty.hidden = count !== 0;
      if (status)
        status.textContent = `${count} ${count === 1 ? 'project' : 'projects'} shown.`;
    }),
  );
</script>
